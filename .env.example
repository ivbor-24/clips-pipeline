# Template of .env. ./setup.sh creates .env from it and fills in the Docker
# settings (GPU, your user, models, network access); run it again to change
# them. By hand: cp .env.example .env and edit.
#
# docker-compose.yml reads these via ${VAR} substitution; the API, the job
# worker and `just` recipes read this file directly. Real environment
# variables win over it. Values left blank below are optional.

# ---- GPU backend -----------------------------------------------------------
# cpu | cuda (NVIDIA) | openvino (Intel Arc). Picks the image that is built and
# the job worker that starts; the two lines must name the same backend.
GPU_BACKEND=cpu
COMPOSE_PROFILES=cpu

# ---- Docker -----------------------------------------------------------------
# Containers run as this user, so files in data/, jobs/, uploads/ stay yours:
#   id -u; id -g
HOST_UID=1000
HOST_GID=1000
# Intel GPUs only: the host's render group, which may use the GPU:
#   getent group render | cut -d: -f3
RENDER_GID=
# NVIDIA only: GPU compute capabilities llama.cpp is compiled for, e.g. 86 for
# an RTX 30 card (nvidia-smi --query-gpu=compute_cap --format=csv). setup.sh
# fills it in. Empty: RTX 20 to RTX 50, a much longer build.
CUDA_ARCHITECTURES=
# Parallel compile jobs for the whisper.cpp and llama-cpp-python build steps.
# Empty: automatic (fit the host's RAM). A build killed with "exit code: 137"
# ran out of memory - set this to 2 (or 1) to use less.
BUILD_JOBS=
# Model weights (~11 GB). Point it at a directory that already has them
# (GGUF, ggml) to skip downloading them again.
MODELS_DIR=./models
# The web UI listens here. 127.0.0.1: this computer only. 0.0.0.0: the local
# network too - set API_PASSWORD below first.
BIND_ADDRESS=127.0.0.1
WEB_PORT=8080
# Network for building the images and downloading the models. Leave it empty;
# host only when containers have no internet access while this computer has
# (often a firewall such as ufw blocking Docker's forwarding). setup.sh checks.
SETUP_NETWORK=

# ---- API (backend service) --------------------------------------------------
# Access: one user. Leave API_PASSWORD empty for no login (fine while the
# service is reachable only from this computer). Set a shared password before
# opening it to the local network; every browser, this computer's too, will
# then ask for it. Changing the password signs everyone out.
API_PASSWORD=
# Required only with API_PASSWORD: signs the login sessions. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
API_JWT_SECRET=
# Days a login stays valid.
API_SESSION_DAYS=30
# Largest video the web UI accepts, in GB. Uploads also need about twice the
# file size of free disk space (the job keeps its own copy).
API_MAX_UPLOAD_GB=10
# Turn everything off after this many minutes without an open web page and
# without queued or running jobs (closing a tab alone never stops a job).
# 0: never. Start again with `just up`.
API_IDLE_SHUTDOWN_MIN=60
API_DATABASE_URL=sqlite+aiosqlite:///./data/api.db
API_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost
# Without API_PASSWORD the API answers only to localhost, IP addresses and these
# host names, comma-separated (protection from other web sites: DNS rebinding).
# Example: the name of this computer if you open the web UI by it.
API_ALLOWED_HOSTS=
API_LOG_LEVEL=INFO

# ---- Local LLM (scoring.llm.provider=llama_cpp) -----------------------------
# Only needed for gated Hugging Face repos (e.g. the default
# google/gemma-4-E4B-it-qat-q4_0-gguf). Get a token at
# https://huggingface.co/settings/tokens and accept the model's license first.
HF_TOKEN=

# ---- Cloud LLM (scoring.llm.provider=openai / anthropic) -------------------
# Only the one matching scoring.llm.provider is needed; ./setup.sh asks for it
# when you choose an API provider (and the provider and model go into
# data/settings.yaml). OPENAI_API_KEY also serves OpenAI-compatible services
# (scoring.llm.api_base). Keeping the key here keeps it out of the repo.
# With --yes, a key set here makes ./setup.sh use that provider instead of
# downloading Qwen3-14B.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
