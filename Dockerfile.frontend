FROM node:20-alpine AS builder

WORKDIR /app

COPY web/package*.json ./

RUN npm ci

COPY web/ .

RUN npm run build

# Debian, like the backend image: the source code of every copyleft package in
# the published images comes from one place (apt-get source, see
# scripts/image_sources.sh). nginx itself is BSD-licensed.
FROM nginx:stable-trixie

# The entrypoint polls the API with wget.
RUN apt-get update \
    && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/dist /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf
# nginx that stops after a shutdown from the web UI.
COPY scripts/web_entrypoint.sh /usr/local/bin/web_entrypoint.sh

EXPOSE 80

CMD ["/usr/local/bin/web_entrypoint.sh"]
