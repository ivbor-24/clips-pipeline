FROM node:20-alpine AS builder

WORKDIR /app

COPY web/package*.json ./

RUN npm ci

COPY web/ .

RUN npm run build

FROM nginx:alpine

COPY --from=builder /app/dist /usr/share/nginx/html

COPY nginx.conf /etc/nginx/conf.d/default.conf
# nginx that stops after a shutdown from the web UI.
COPY scripts/web_entrypoint.sh /usr/local/bin/web_entrypoint.sh

EXPOSE 80

CMD ["/usr/local/bin/web_entrypoint.sh"]
